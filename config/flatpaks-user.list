# config/flatpaks-user.list — per-user Flatpaks (no sudo, personal)
# FORMAT: <remote> <app-id> [branch]. Add -> install --user, remove -> prune removes.
# Put here: dev/personal apps (editors, notes, secrets) so shared system stays lean.
flathub com.visualstudio.code stable
flathub md.obsidian.Obsidian stable
flathub org.keepassxc.KeePassXC stable
