#!/usr/bin/env bash
# luicipheros-install — live-env entry point for the netinstall ISO.
# Flow: preflight -> clone/pull repo -> archinstall (JSON + creds) ->
# reboot into target -> bootstrap runs there (NOT here: bootstrap installs
# into the running system, and the live env is throwaway).
# USAGE (on the booted ISO): luicipheros-install [--vm] [--yes]
#   --vm   relax GPU/ReBAR checks (smoke runs)
#   --yes  skip the final confirm before archinstall writes to disk
set -euo pipefail

VM=false; YES=false
for a in "$@"; do
  case "$a" in
    --vm) VM=true ;;
    --yes|--noconfirm) YES=true ;;
    -h|--help) echo "Usage: $0 [--vm] [--yes]"; exit 0 ;;
  esac
done

REPO_URL="https://github.com/lui-do/LuicipherOS.git"
# Canonical clone location. Override with LUICI_WORK=path only for edge cases.
WORK="${LUICI_WORK:-$HOME/LuicipherOS}"

echo "==> LuicipherOS netinstall (live env: $(uname -r))"
ensure_link() {
  # Ethernet is automatic via NetworkManager. WiFi needs SSID + passphrase.
  echo "Connection type:"
  echo "  1) Ethernet (automatic)"
  echo "  2) WiFi"
  read -r -p "Choose [1/2]: " LINK
  [[ "$LINK" == "2" ]] || return 0
  command -v nmcli &>/dev/null || { echo "FAIL: nmcli missing"; exit 1; }
  command -v rfkill &>/dev/null && rfkill unblock wifi || true
  echo "==> scanning (5s)..."
  nmcli device wifi rescan 2>/dev/null || true
  sleep 5
  nmcli -f SSID,SIGNAL,SECURITY device wifi list | head -15
  read -r -p "SSID: " SSID
  [[ -n "$SSID" ]] || { echo "FAIL: empty SSID"; exit 1; }
  read -r -s -p "WiFi password: " WPA; echo ""
  # --ask: no secret agent in the live env, nmcli must prompt/handle directly.
  nmcli --ask device wifi connect "$SSID" password "$WPA" \
    || { echo "FAIL: could not join $SSID (wrong password?)"; exit 1; }
  echo "==> joined $SSID"
}
ensure_link
ensure_dns() {
  # Live resolvers break in the wild (slirp gateway DNS ignored, stale
  # resolv.conf, IPv6-only answers). Self-heal BEFORE anything needs names:
  # if the default route's gateway answers DNS, pin the uplink to it.
  getent hosts archlinux.org &>/dev/null && return 0
  echo "==> DNS broken, attempting repair via default-route gateway"
  local gw iface
  gw=$(ip route show default 2>/dev/null | awk '{print $3}' | head -1)
  iface=$(ip route show default 2>/dev/null | awk '{print $5}' | head -1)
  [[ -n "$gw" && -n "$iface" ]] || { echo "FAIL: no default route"; exit 1; }
  if command -v resolvectl &>/dev/null; then
    resolvectl dns "$iface" "$gw"
    systemctl restart systemd-resolved 2>/dev/null || true
    sleep 3
  else
    printf 'nameserver %s\n' "$gw" > /etc/resolv.conf
  fi
  getent hosts archlinux.org &>/dev/null \
    || { echo "FAIL: DNS still broken (tried gateway $gw)"; exit 1; }
  echo "==> DNS OK via $gw"
}
ensure_dns
if [[ -d "$WORK/.git" ]]; then
  echo "==> updating existing checkout"
  git -C "$WORK" pull --ff-only
else
  git clone "$REPO_URL" "$WORK"
fi
cd "$WORK"
echo "==> repo: $(git log --oneline -1)"

if [[ "$VM" == true ]]; then
  ./install/preflight.sh --vm
else
  ./install/preflight.sh --target
fi

echo ""
echo "==> EDIT-ME check (hostname/btrfs size still manual; device is automatic):"
echo "    $WORK/install/archinstall-desktop.json"
echo "    lsblk disks: $(lsblk -d -n -o NAME,SIZE | tr '\n' ' ')"
# Device select: --vm -> /dev/vda, otherwise the target default.
# Written to a COPY (/tmp/...): the repo JSON is never mutated, so `git pull`
# stays clean. (Full lsblk picker is issue #2.)
TARGET_DEV="/dev/nvme0n1"
if [[ "$VM" == true ]]; then TARGET_DEV="/dev/vda"; fi
export TARGET_DEV WORK
python3 -c 'import json,os; p=os.environ["WORK"]+"/install/archinstall-desktop.json"; d=json.load(open(p)); d["disk_config"]["device_modifications"][0]["device"]=os.environ["TARGET_DEV"]; json.dump(d,open("/tmp/luicipheros-archinstall.json","w"),indent=2)'
echo "==> install device: $TARGET_DEV (via /tmp/luicipheros-archinstall.json)"
ensure_creds() {
  # Interactive first-boot users: sudo user + root password -> /tmp/creds.json.
  # Extra users are added later inside the installed OS, not here.
  [[ -f /tmp/creds.json ]] && return 0
  command -v openssl &>/dev/null || { echo "FAIL: openssl missing, cannot hash passwords"; exit 1; }
  command -v python3 &>/dev/null || { echo "FAIL: python3 missing, cannot write creds"; exit 1; }
  read -r -p "sudo username [luci]: " LUCI_USER
  LUCI_USER="${LUCI_USER:-luci}"
  ask_pw_twice() { # $1 = label, prints password to stdout; retries on mismatch
    # NOTE: this runs inside $(...) so EVERYTHING except the final password
    # must go to stderr. A single `echo` to stdout lands inside the password
    # (hash of "\n\n<typed>" != typed at login). That bug locked out two
    # installs before the one-line prompt gave it away (Oct 2026).
    local label="$1" a b
    while true; do
      read -r -s -p "password for $label: " a; echo "" >&2
      [[ -n "$a" ]] || { echo "empty password, try again" >&2; continue; }
      read -r -s -p "confirm password for $label: " b; echo "" >&2
      [[ "$a" == "$b" ]] || { echo "mismatch, try again" >&2; continue; }
      printf '%s' "$a"
      return 0
    done
  }
  LUCI_PW="$(ask_pw_twice "$LUCI_USER")"
  ROOT_PW="$(ask_pw_twice root)"
  export LUCI_USER LUCI_PW ROOT_PW
  python3 - <<'EOF'
import json, os, subprocess
def h(pw):
    return subprocess.run(
        ["openssl", "passwd", "-6", pw],
        capture_output=True, text=True, check=True).stdout.strip()
d = {"users": [{"sudo": True,
                "username": os.environ["LUCI_USER"],
                "enc_password": h(os.environ["LUCI_PW"])}],
     "root_enc_password": h(os.environ["ROOT_PW"])}
with open("/tmp/creds.json", "w") as f:
    json.dump(d, f, indent=2)
EOF
  unset LUCI_PW ROOT_PW
  chmod 600 /tmp/creds.json
  python3 -m json.tool /tmp/creds.json > /dev/null && echo "==> creds written to /tmp/creds.json"
}
ensure_creds
ensure_keyring() {
  # Fresh live boots start with NO keyring (or a broken one): without this,
  # every pacman/archinstall run dies with keyring errors. Idempotent:
  # healthy keyrings (>=3 master keys) are left alone.
  local count=0
  count=$(pacman-key --list-keys 2>/dev/null | grep -c '^pub' || true)
  if [[ "$count" -ge 3 ]]; then return 0; fi
  echo "==> (re)building live keyring ($count keys found, need >=3)"
  rm -rf /etc/pacman.d/gnupg
  pacman-key --init
  pacman-key --populate archlinux
  count=$(pacman-key --list-keys 2>/dev/null | grep -c '^pub' || true)
  [[ "$count" -ge 3 ]] || { echo "FAIL: keyring still unhealthy ($count keys)"; exit 1; }
  echo "==> keyring OK ($count keys)"
}
ensure_keyring
echo "==> verifying mirror sync (archinstall inherits this mirrorlist)"
pacman -Syy || { echo "FAIL: mirror sync failed — fix /etc/pacman.d/mirrorlist, then re-run"; exit 1; }
if [[ "$YES" == false ]]; then
  read -r -p "Run archinstall now? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "aborted (repo kept at $WORK)"; exit 1; }
fi

# NOTE: --skip-wkd: the wkd-sync wait hangs in minimal live envs without the
# timer unit (and crawls through slirp even with it). ISO keys are build-fresh.
archinstall --config /tmp/luicipheros-archinstall.json --creds /tmp/creds.json --skip-wkd

echo ""
echo "==> base installed. Next:"
echo "    1) reboot into the new system (remove media / fix boot order)"
echo "    2) git clone $REPO_URL && cd LuicipherOS"
echo "    3) ./install/bootstrap.sh   (add --preflight-mode=vm --no-flatpak for smoke)"
