#!/usr/bin/env bash
# luicipheros-install — live-env entry point for the netinstall ISO.
# Flow: preflight -> clone/pull repo -> archinstall (JSON + creds) ->
# reboot into target -> bootstrap runs there (NOT here: bootstrap installs
# into the running system, and the live env is throwaway).
# USAGE (on the booted ISO): luicipheros-install [--vm] [--yes]
#   --vm   relax GPU/ReBAR checks (smoke runs)
#   --yes  skip the final confirm before archinstall writes to disk
set -euo pipefail

VM=false; YES=false
for a in "$@"; do
  case "$a" in
    --vm) VM=true ;;
    --yes|--noconfirm) YES=true ;;
    -h|--help) echo "Usage: $0 [--vm] [--yes]"; exit 0 ;;
  esac
done

REPO_URL="https://github.com/lui-do/LuicipherOS.git"
WORK="$HOME/luicipheros-install"

echo "==> LuicipherOS netinstall (live env: $(uname -r))"
if [[ -d "$WORK/.git" ]]; then
  echo "==> updating existing checkout"
  git -C "$WORK" pull --ff-only
else
  git clone "$REPO_URL" "$WORK"
fi
cd "$WORK"
echo "==> repo: $(git log --oneline -1)"

if [[ "$VM" == true ]]; then
  ./install/preflight.sh --vm
else
  ./install/preflight.sh --target
fi

echo ""
echo "==> EDIT-ME before install (in another TTY or now):"
echo "    $WORK/install/archinstall-desktop.json  (device, btrfs GiB size, hostname)"
echo "    lsblk disks: $(lsblk -d -n -o NAME,SIZE | tr '\n' ' ')"
ensure_creds() {
  # Interactive first-boot users: sudo user + root password -> /tmp/creds.json.
  # Extra users are added later inside the installed OS, not here.
  [[ -f /tmp/creds.json ]] && return 0
  command -v openssl &>/dev/null || { echo "FAIL: openssl missing, cannot hash passwords"; exit 1; }
  command -v python3 &>/dev/null || { echo "FAIL: python3 missing, cannot write creds"; exit 1; }
  read -r -p "sudo username [luci]: " LUCI_USER
  LUCI_USER="${LUCI_USER:-luci}"
  read -r -s -p "password for $LUCI_USER: " LUCI_PW; echo ""
  [[ -n "$LUCI_PW" ]] || { echo "FAIL: empty password"; exit 1; }
  read -r -s -p "password for root: " ROOT_PW; echo ""
  [[ -n "$ROOT_PW" ]] || { echo "FAIL: empty password"; exit 1; }
  export LUCI_USER LUCI_PW ROOT_PW
  python3 - <<'EOF'
import json, os, subprocess
def h(pw):
    return subprocess.run(
        ["openssl", "passwd", "-6", pw],
        capture_output=True, text=True, check=True).stdout.strip()
d = {"users": [{"sudo": True,
                "username": os.environ["LUCI_USER"],
                "enc_password": h(os.environ["LUCI_PW"])}],
     "root_enc_password": h(os.environ["ROOT_PW"])}
with open("/tmp/creds.json", "w") as f:
    json.dump(d, f, indent=2)
EOF
  unset LUCI_PW ROOT_PW
  chmod 600 /tmp/creds.json
  python3 -m json.tool /tmp/creds.json > /dev/null && echo "==> creds written to /tmp/creds.json"
}
ensure_creds
ensure_keyring() {
  # Fresh live boots start with NO keyring (or a broken one): without this,
  # every pacman/archinstall run dies with keyring errors. Idempotent:
  # healthy keyrings (>=3 master keys) are left alone.
  local count=0
  count=$(pacman-key --list-keys 2>/dev/null | grep -c '^pub' || true)
  if [[ "$count" -ge 3 ]]; then return 0; fi
  echo "==> (re)building live keyring ($count keys found, need >=3)"
  rm -rf /etc/pacman.d/gnupg
  pacman-key --init
  pacman-key --populate archlinux
  count=$(pacman-key --list-keys 2>/dev/null | grep -c '^pub' || true)
  [[ "$count" -ge 3 ]] || { echo "FAIL: keyring still unhealthy ($count keys)"; exit 1; }
  echo "==> keyring OK ($count keys)"
}
ensure_keyring
if [[ "$YES" == false ]]; then
  read -r -p "Run archinstall now? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "aborted (repo kept at $WORK)"; exit 1; }
fi

# NOTE: --skip-wkd: the wkd-sync wait hangs in minimal live envs without the
# timer unit (and crawls through slirp even with it). ISO keys are build-fresh.
archinstall --config "$WORK/install/archinstall-desktop.json" --creds /tmp/creds.json --skip-wkd

echo ""
echo "==> base installed. Next:"
echo "    1) reboot into the new system (remove media / fix boot order)"
echo "    2) git clone $REPO_URL && cd LuicipherOS"
echo "    3) ./install/bootstrap.sh   (add --preflight-mode=vm --no-flatpak for smoke)"
