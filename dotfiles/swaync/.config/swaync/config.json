{
  "_note": "LuicipherOS swaync v0.1 — kept notifier (CONTEXT.md). SUPER+N toggles panel (see hypr/lua/binds.lua). Kept until the Quickshell shell grows its own notification center (v0.2).",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 380,
  "notification-window-width": 380,
  "timeout": 8,
  "timeout-low": 4,
  "keyboard-shortcuts": true,
  "widgets": ["title", "dnd", "notifications", "mpris", "buttons-grid"],
  "widget-config": {
    "title": { "text": "Notifications", "clear-all-button": true, "button-text": "Clear" },
    "dnd": { "text": "Do Not Disturb" },
    "mpris": { "image-size": 96, "image-radius": 8 },
    "buttons-grid": {
      "actions": [
        { "label": "󰐥", "command": "systemctl poweroff" },
        { "label": "󰜉", "command": "systemctl reboot" },
        { "label": "󰌾", "command": "hyprlock" },
        { "label": "󰖔", "command": "tabby -e nmtui" }
      ]
    }
  }
}
