# Late amdgpu load — cold-boot DMUB race workaround (RX 7900 XT, Oct 2026).
# Early-boot amdgpu probe hits an unready SMU (status=2 storm); the same
# driver loaded ~3 minutes later initializes cleanly every time (the proven
# manual procedure). So the driver stays soft-blacklisted (modprobe.d conf +
# modprobe.blacklist= on the kernel line) and this unit automates the wait:
# sleep 150 s (boot consumes the rest of the ~190 s window), then modprobe,
# then greetd starts on the now-working display.
# Deployed by install/bootstrap.sh (root-owned). To revert to the manual era:
# re-add `systemd.mask=amdgpu-late.service 3` to the boot entry options.
[Unit]
Description=Late amdgpu load (cold-boot DMUB race workaround)
Before=greetd.service
After=systemd-udev-trigger.service systemd-modules-load.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 150
ExecStart=/usr/bin/modprobe amdgpu
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
